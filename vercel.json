{
  "rewrites": [
    {
      "source": "/llm.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/|llms\\.txt|robots\\.txt|sitemap\\.xml|favicon\\.svg|google[a-z0-9]+\\.html|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
